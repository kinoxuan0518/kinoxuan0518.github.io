{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/audio/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    }
  ],
  "functions": {
    "api/chat.js": {
      "maxDuration": 60
    },
    "api/ink.js": {
      "maxDuration": 15
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "https://kinoxuan0518.github.io/",
      "permanent": false
    },
    {
      "source": "/index.html",
      "destination": "https://kinoxuan0518.github.io/",
      "permanent": false
    }
  ]
}
